# Base URL for the backend API (Laravel)
# Dev:  http://localhost:8000/api/v1
# Prod: https://api.your-domain.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Base URL for the Laravel app root (used for CSRF cookie endpoint /sanctum/csrf-cookie)
# Dev:  http://localhost:8000
# Prod: https://api.your-domain.com
VITE_API_ROOT_URL=http://localhost:8000
